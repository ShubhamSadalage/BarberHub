@using BarberHub.Web.Features.Services
@model ServiceUpsertDto
@{ ViewData["Title"] = "Edit Service"; }

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2">
            <div>
                <h2 class="section-title">Edit Service</h2>
                <p class="section-subtitle mb-0">Update pricing, duration, or visibility.</p>
            </div>
            <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>

        <div class="bh-card p-4 p-md-5">
            <partial name="_ValidationSummary" />
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" class="form-select">
                            <option>Hair</option>
                            <option>Beard</option>
                            <option>Combo</option>
                            <option>Kids</option>
                            <option>Colour</option>
                            <option>Skin</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label">Price (₹)</label>
                        <input asp-for="Price" type="number" step="1" min="1" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DurationMinutes" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="DurationMinutes" type="number" step="5" min="5" class="form-control" />
                            <span class="input-group-text">min</span>
                        </div>
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Visible to customers</label>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
