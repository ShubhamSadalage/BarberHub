@using BarberHub.Web.Features.Services
@model TemplateActivateDto
@{ ViewData["Title"] = "Add from Templates"; }

<div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2">
    <div>
        <h2 class="section-title">Add from Templates</h2>
        <p class="section-subtitle mb-0">Select the services you offer and set your prices. You can edit them later.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<form asp-action="Templates" method="post">
    @Html.AntiForgeryToken()
    @{
        var groups = Model.Items.GroupBy(i => i.Category).OrderBy(g => g.Key).ToList();
        int idx = 0;
    }

    @foreach (var group in groups)
    {
        <h5 class="mt-4 mb-2 fw-semibold" style="color:var(--bh-text-muted);font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;">
            <i class="bi bi-tag me-1 text-coral"></i>@group.Key
        </h5>
        <div class="bh-card p-0 overflow-hidden mb-3">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3" style="width:44px;"></th>
                            <th>Service</th>
                            <th style="width:160px;">Your price (₹)</th>
                            <th style="width:140px;">Duration (min)</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in group)
                    {
                        <tr>
                            <td class="ps-3">
                                <input type="hidden" name="Items[@idx].Name"          value="@item.Name" />
                                <input type="hidden" name="Items[@idx].Category"       value="@item.Category" />
                                <input type="hidden" name="Items[@idx].Description"    value="@item.Description" />
                                <input class="form-check-input" type="checkbox"
                                       name="Items[@idx].Selected" value="true"
                                       id="chk_@idx" @(item.Selected ? "checked" : "") />
                            </td>
                            <td>
                                <label for="chk_@idx" class="fw-semibold mb-0 d-block" style="cursor:pointer;">@item.Name</label>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <small class="text-muted">@item.Description</small>
                                }
                            </td>
                            <td>
                                <input type="number" name="Items[@idx].Price"
                                       value="@item.Price" min="1" step="1"
                                       class="form-control form-control-sm" />
                            </td>
                            <td>
                                <input type="number" name="Items[@idx].DurationMinutes"
                                       value="@item.DurationMinutes" min="5" step="5"
                                       class="form-control form-control-sm" />
                            </td>
                        </tr>
                        idx++;
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary btn-lg"><i class="bi bi-check2 me-1"></i>Add selected services</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
    </div>
</form>
