@using BarberHub.Web.Features.Barbers.Dtos
@using BarberHub.Web.Shared.Config
@using Microsoft.Extensions.Options
@inject IOptions<FeatureFlags> FF
@inject IOptions<GoogleOptions> GO
@model List<BarberListItemDto>
@{
    ViewData["Title"] = "Find Barbers";
    var search = ViewBag.Search as BarberSearchDto ?? new BarberSearchDto();
    var mapsEnabled = FF.Value.MapsEnabled && !string.IsNullOrEmpty(GO.Value.Maps.ApiKey);
}

<div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2">
    <div>
        <h2 class="section-title">Find Barbers</h2>
        <p class="section-subtitle mb-0">Discover top-rated grooming experts near you.</p>
    </div>
    <span class="badge bg-light text-dark px-3 py-2"><i class="bi bi-shop me-1"></i>@Model.Count results</span>
</div>

@* Search bar always visible at top *@
<div class="bh-card p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-9">
            <label class="form-label"><i class="bi bi-geo me-1"></i>Search a city or area</label>
            <input name="City" id="bhBarberCity" value="@search.City" class="form-control"
                   placeholder="Pune, Andheri, Whitefield…" autocomplete="off" />
        </div>
        <input name="Latitude" id="bhLat" type="hidden" value="@search.Latitude" />
        <input name="Longitude" id="bhLng" type="hidden" value="@search.Longitude" />
        <input name="RadiusKm" type="hidden" value="@(search.RadiusKm > 0 ? search.RadiusKm : 25)" />
        <div class="col-md-3 d-flex flex-wrap gap-2">
            <button class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Search</button>
            <button type="button" class="btn btn-outline-secondary flex-grow-1" id="bhUseMyLoc">
                <i class="bi bi-geo-alt me-1"></i>Near me
            </button>
        </div>
    </form>
</div>

@* Map only shown when Google Maps API is configured *@
@if (mapsEnabled)
{
    <div class="mb-4">
        <partial name="Maps/_BarbersMap" model="@Model" />
    </div>
}

@if (!Model.Any())
{
    <div class="bh-card p-5 text-center">
        <div class="stat-icon amber mx-auto mb-3" style="width:64px;height:64px;font-size:1.6rem;">
            <i class="bi bi-search"></i>
        </div>
        <h5>No barbers found</h5>
        <p class="text-muted mb-0">Try a different city or use your location.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var b in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <a asp-action="Details" asp-route-id="@b.Id" class="text-decoration-none text-reset d-block h-100">
                    <div class="barber-card">
                        @* Cover band *@
                        <div class="barber-cover">
                            @if (!string.IsNullOrEmpty(b.ProfileImageUrl))
                            {
                                <img class="barber-cover-img" src="@b.ProfileImageUrl" alt="" />
                            }
                            @if (b.DistanceKm.HasValue)
                            {
                                <span style="position:absolute;top:10px;right:12px;background:rgba(255,255,255,.9);
                                    border-radius:999px;padding:4px 10px;font-size:.75rem;font-weight:600;">
                                    <i class="bi bi-geo-alt text-coral me-1"></i>@b.DistanceKm.Value.ToString("0.#") km
                                </span>
                            }
                        </div>

                        @* Avatar floating over the cover *@
                        <div class="barber-avatar">
                            @if (!string.IsNullOrEmpty(b.ProfileImageUrl))
                            {
                                <img src="@b.ProfileImageUrl" alt="@b.FullName"
                                     style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                            }
                            else
                            {
                                @((b.ShopName ?? b.FullName).Substring(0, 1).ToUpper())
                            }
                        </div>

                        @* Card body *@
                        <div class="px-4 pb-4 pt-2 flex-grow-1 d-flex flex-column">
                            <h5 class="mb-1 mt-1" style="font-size:1.05rem;">@b.ShopName</h5>
                            <div class="text-muted small mb-2">by @b.FullName</div>

                            @if (!string.IsNullOrEmpty(b.City))
                            {
                                <div class="text-muted small">
                                    <i class="bi bi-pin-map me-1 text-coral"></i>@b.City
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(b.Address))
                            {
                                <div class="text-muted small mb-2">@b.Address</div>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-scissors me-1"></i>@b.ServiceCount services
                                </span>
                                @if (b.MinPrice.HasValue)
                                {
                                    <span class="small fw-semibold text-coral">From ₹@b.MinPrice.Value.ToString("0")</span>
                                }
                            </div>

                            <div class="btn btn-primary w-100 mt-3">
                                View & Book <i class="bi bi-arrow-right ms-1"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@section Scripts {
<script>
(function() {
    const btn = document.getElementById('bhUseMyLoc');
    if (!btn || !navigator.geolocation) { if (btn) btn.style.display = 'none'; return; }
    btn.addEventListener('click', function() {
        if (window.bhToast) window.bhToast('Getting your location…', 'info');
        navigator.geolocation.getCurrentPosition(
            function(p) {
                document.getElementById('bhLat').value = p.coords.latitude.toFixed(6);
                document.getElementById('bhLng').value = p.coords.longitude.toFixed(6);
                btn.closest('form').submit();
            },
            function(err) {
                if (window.bhToast) window.bhToast('Location unavailable: ' + err.message, 'error');
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
        );
    });
})();
</script>
}
